TMAKE_DIR = $(SRCDIR)/make
include $(TMAKE_DIR)/tmake-init.mk

DOCS = $(SRCDIR)/COPYING.txt $(SRCDIR)/README.md
DOCSDIR = $(DOCDIR)/tash
FILESGROUPS += DOCS

PACKAGE = tash
VERSION := $(shell git -C $(SRCDIR) describe --tags --always 2>/dev/null || echo unknown)
SRCS = $(wildcard $(SRCDIR)/src/*.c)
CFLAGS += -I$(SRCDIR)/include --std=c99 -D_POSIX_C_SOURCE=200809L
CFLAGS += -DVERSION='"$(VERSION)"'
CFLAGS += -DLOCALEDIR='"$(LOCALEDIR)"'

include $(TMAKE_DIR)/tmake-prog.mk
include $(TMAKE_DIR)/tmake-locale.mk
